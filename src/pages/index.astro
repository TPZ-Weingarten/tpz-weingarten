---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import TeamGrid from '../components/TeamGrid.astro';
import Icon from '../components/Icon.astro';
import { img } from '../lib/images';
import { url } from '../lib/url';

const site = (await getEntry('site', 'site'))!.data;
const page = (await getEntry('pages', 'index'))!;
const { Content } = await render(page);
const { description, heading, subtitle, hero, features = [], teasers = [], introImage } = page.data;
---

<BaseLayout description={description}>
  <section class="hero">
    {hero && <Image src={img(hero)} alt="" widths={[640, 1024, 1600, 1920]} sizes="100vw" loading="eager" fetchpriority="high" class="hero-bg" />}
    <div class="container hero-content">
      <p class="eyebrow eyebrow--light">Physiotherapie in Weingarten</p>
      <h1>{heading}</h1>
      {subtitle && <p class="hero-sub">{subtitle}</p>}
      <div class="hero-cta">
        <a class="btn btn--primary" href={`tel:${site.phone.href}`}><Icon name="phone" size={18} /> {site.phone.display}</a>
        <a class="btn btn--ghost" href={url('/therapiespektrum')}>Therapiespektrum <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>

  {
    features.length > 0 && (
      <section class="features" aria-label="Unsere Stärken">
        <div class="container">
          <ul>
            {features.map((f) => (
              <li>
                <a href={url(f.href)}>
                  <span class="feature-icon">
                    <Icon name={f.icon} size={26} />
                  </span>
                  {f.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section intro">
    <div class="container split">
      <div class="prose">
        <p class="eyebrow">Willkommen</p>
        <Content />
        <p class="intro-links">
          <a class="btn btn--outline" href={url('/behandlungskonzept')}>Unser Behandlungskonzept <Icon name="arrow" size={18} /></a>
        </p>
      </div>
      {introImage && <Image src={img(introImage)} alt="Einblick in unsere Praxisräume" widths={[480, 800, 1100]} sizes="(max-width: 860px) 100vw, 40vw" class="intro-pic" />}
    </div>
  </section>

  {
    teasers.length > 0 && (
      <section class="section teasers-section">
        <div class="container">
          <p class="eyebrow">Therapiespektrum</p>
          <h2>Ein kleiner Einblick</h2>
          <ul class="teasers">
            {teasers.map((t) => (
              <li>
                <a href={url(t.href)}>
                  <Image src={img(t.image)} alt="" widths={[480, 800, 1100]} sizes="(max-width: 720px) 100vw, 50vw" />
                  <span class="teaser-body">
                    <strong>{t.title}</strong>
                    {t.text && <span>{t.text}</span>}
                    <span class="more">
                      Mehr erfahren <Icon name="arrow" size={18} />
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <TeamGrid />
</BaseLayout>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(30rem, 70vh, 42rem);
    color: #fff;
    background: var(--grey);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(20 24 16 / 0.78) 0%, rgb(20 24 16 / 0.45) 50%, rgb(20 24 16 / 0.1) 100%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    padding-block: 4rem 6rem;
  }

  .hero h1 {
    max-width: 18ch;
    margin-bottom: 1rem;
  }

  .eyebrow--light {
    color: #fff;
  }

  .hero-sub {
    max-width: 38rem;
    font-size: 1.2rem;
    color: rgb(255 255 255 / 0.92);
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .features {
    position: relative;
    z-index: 2;
    margin-top: -3.5rem;
  }

  .features ul {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--bg);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .features li + li {
    border-left: 1px solid var(--green-line);
  }

  .features a {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 100%;
    padding: 1.5rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--text);
    text-decoration: none;
    transition: background-color 0.15s;
  }

  .features a:hover {
    background: var(--green-tint);
  }

  .feature-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--green);
    color: #16210a;
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .intro .prose :global(p:nth-of-type(2)) {
    font-size: 1.2rem;
    color: var(--text);
  }

  .intro-links {
    margin-top: 2rem;
  }

  .intro-pic {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .teasers-section {
    padding-top: 0;
  }

  .teasers {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .teasers a {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    color: #fff;
    text-decoration: none;
    box-shadow: var(--shadow);
  }

  .teasers :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }

  .teasers a:hover :global(img) {
    transform: scale(1.04);
  }

  .teaser-body {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 3rem 1.5rem 1.4rem;
    background: linear-gradient(180deg, transparent, rgb(0 0 0 / 0.7));
  }

  .teaser-body strong {
    font-size: 1.5rem;
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    color: var(--green);
  }

  @media (max-width: 960px) {
    .features ul {
      grid-template-columns: repeat(2, 1fr);
    }

    .features li:nth-child(3) {
      border-left: 0;
    }

    .features li:nth-child(n + 3) {
      border-top: 1px solid var(--green-line);
    }
  }

  @media (max-width: 860px) {
    .split {
      grid-template-columns: 1fr;
    }

    .intro-pic {
      aspect-ratio: 16 / 10;
    }
  }

  @media (max-width: 720px) {
    .hero::after {
      background: linear-gradient(180deg, rgb(20 24 16 / 0.35) 0%, rgb(20 24 16 / 0.8) 100%);
    }

    .hero {
      align-items: flex-end;
    }

    .teasers {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .features ul {
      grid-template-columns: 1fr;
    }

    .features li + li {
      border-left: 0;
      border-top: 1px solid var(--green-line);
    }

    .features a {
      padding: 1.1rem 1.25rem;
    }
  }
</style>
