---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import { img } from '../lib/images';

const all = (await getCollection('leistungen')).sort((a, b) => a.data.order - b.data.order);
// Leistungen mit Text bekommen einen eigenen Abschnitt, die übrigen erscheinen als kompakte Liste.
const detailed = all.filter((l) => l.body?.trim());
const more = all.filter((l) => !l.body?.trim());
const rendered = await Promise.all(detailed.map(async (l) => ({ ...l, Content: (await render(l)).Content })));
---

<PageLayout page="therapiespektrum">
  <nav class="jump" aria-label="Leistungen">
    <div class="container">
      <ul>
        {
          all.map((l) => (
            <li>
              <a href={`#${l.id}`}>{l.data.title}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  {
    rendered.map(({ id, data, Content }, i) => (
      <section id={id} class:list={['section', 'leistung', { 'section--tint': i % 2 === 1 }]}>
        <div class:list={['container', 'split', { 'split--flip': i % 2 === 1 }]}>
          <div class="prose">
            <h2>{data.title}</h2>
            <Content />
          </div>
          {data.image && (
            <Image
              src={img(data.image)}
              alt={data.imageAlt ?? data.title}
              widths={[480, 800, 1100]}
              sizes="(max-width: 860px) 100vw, 40vw"
              class="pic"
            />
          )}
        </div>
      </section>
    ))
  }

  {
    more.length > 0 && (
      <section class:list={['section', { 'section--tint': rendered.length % 2 === 1 }]}>
        <div class="container">
          <h2 class="more-title">Außerdem bieten wir</h2>
          <ul class="more">
            {more.map((l) => (
              <li id={l.id}>{l.data.title}</li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</PageLayout>

<style>
  .jump {
    position: sticky;
    top: var(--header-h);
    z-index: 10;
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--green-line);
  }

  .jump ul {
    display: flex;
    gap: 0.5rem;
    margin: 0;
    padding: 0.75rem 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .jump a {
    display: block;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--green-line);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
    color: var(--text);
    background: var(--bg);
  }

  .jump a:hover {
    border-color: var(--green);
    background: var(--green-tint);
  }

  .leistung {
    scroll-margin-top: calc(var(--header-h) + 3.5rem);
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
  }

  .split--flip .prose {
    order: 2;
  }

  .split .prose h2:first-child {
    color: var(--text);
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.125rem);
  }

  .pic {
    position: sticky;
    top: calc(var(--header-h) + 5rem);
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .more-title {
    margin-bottom: 1.5rem;
  }

  .more {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .more li {
    padding: 1rem 1.5rem;
    background: var(--bg);
    border-left: 4px solid var(--green);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow);
    font-weight: 600;
    scroll-margin-top: calc(var(--header-h) + 5rem);
  }

  @media (max-width: 860px) {
    .split {
      grid-template-columns: 1fr;
    }

    .split--flip .prose {
      order: 0;
    }

    .pic {
      position: static;
    }
  }
</style>
