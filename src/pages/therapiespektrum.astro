---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import Icon from '../components/Icon.astro';
import { img } from '../lib/images';

const all = (await getCollection('leistungen')).sort((a, b) => a.data.order - b.data.order);
// Leistungen mit Text bekommen einen eigenen Abschnitt, die übrigen erscheinen als kompakte Liste.
const detailed = all.filter((l) => l.body?.trim());
const more = all.filter((l) => !l.body?.trim());
const rendered = await Promise.all(detailed.map(async (l) => ({ ...l, Content: (await render(l)).Content })));
---

<PageLayout page="therapiespektrum">
  <nav class="jump" aria-label="Leistungen">
    <div class="container">
      <button class="jump-toggle" type="button" aria-expanded="false" aria-controls="jump-list">
        <span>Leistungen</span>
        <span class="jump-current"></span>
        <Icon name="chevron" size={20} class="chevron" />
      </button>
      <ul id="jump-list">
        {
          all.map((l) => (
            <li>
              <a href={`#${l.id}`}>{l.data.short ?? l.data.title}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  {
    rendered.map(({ id, data, Content }, i) => (
      <section id={id} class:list={['section', 'leistung', { 'section--tint': i % 2 === 1 }]}>
        <div class:list={['container', 'split', { 'split--flip': i % 2 === 1 }]}>
          <div class="prose">
            <h2>{data.title}</h2>
            <Content />
          </div>
          {data.image && (
            <Image
              src={img(data.image)}
              alt={data.imageAlt ?? data.title}
              widths={[480, 800, 1100]}
              sizes="(max-width: 860px) 100vw, 40vw"
              class="pic"
            />
          )}
        </div>
      </section>
    ))
  }

  {
    more.length > 0 && (
      <section class:list={['section', { 'section--tint': rendered.length % 2 === 1 }]}>
        <div class="container">
          <h2 class="more-title">Außerdem bieten wir</h2>
          <ul class="more">
            {more.map((l) => (
              <li id={l.id}>{l.data.title}</li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</PageLayout>

<style>
  .jump {
    --jump-h: 3.5rem;
    position: sticky;
    top: var(--header-h);
    z-index: 10;
    background: rgb(255 255 255 / 0.94);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--green-line);
    box-shadow: 0 8px 16px -14px rgb(0 0 0 / 0.4);
  }

  .jump ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0.6rem 0;
    list-style: none;
  }

  .jump a {
    display: block;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--green-line);
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--text);
    background: var(--bg);
    transition:
      background-color 0.15s,
      border-color 0.15s;
  }

  .jump a:hover {
    border-color: var(--green);
    background: var(--green-tint);
  }

  .jump a[aria-current='true'] {
    border-color: var(--green);
    background: var(--green);
    color: #16210a;
  }

  .jump-toggle {
    display: none;
  }

  /* Abschnitte nicht unter Header + Leiste verstecken */
  .leistung,
  .more li {
    scroll-margin-top: 5rem; /* zusätzlich zu scroll-padding-top am html (Header) */
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
  }

  .split--flip .prose {
    order: 2;
  }

  .split .prose h2:first-child {
    color: var(--text);
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.125rem);
  }

  .pic {
    position: sticky;
    top: calc(var(--header-h) + 7rem);
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .more-title {
    margin-bottom: 1.5rem;
  }

  .more {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .more li {
    padding: 1rem 1.5rem;
    background: var(--bg);
    border-left: 4px solid var(--green);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow);
    font-weight: 600;
  }

  @media (max-width: 860px) {
    .jump-toggle {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      width: 100%;
      padding: 0.85rem 0;
      background: none;
      border: 0;
      font: inherit;
      font-weight: 600;
      color: var(--text);
      cursor: pointer;
    }

    .jump-current {
      flex: 1;
      overflow: hidden;
      text-align: left;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-weight: 400;
      color: var(--green-dark);
    }

    .jump-current:not(:empty)::before {
      content: '· ';
      color: var(--muted);
    }

    .jump :global(.chevron) {
      flex: none;
      margin-left: auto;
      transition: transform 0.2s;
    }

    .jump.open :global(.chevron) {
      transform: rotate(180deg);
    }

    .jump ul {
      display: none;
      padding: 0 0 1rem;
    }

    .jump.open ul {
      display: flex;
    }

    .jump a {
      padding: 0.4rem 0.9rem;
      font-size: 0.95rem;
    }

    .leistung,
    .more li {
      scroll-margin-top: 2.75rem;
    }

    .split {
      grid-template-columns: 1fr;
    }

    .split--flip .prose {
      order: 0;
    }

    .pic {
      position: static;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('.jump');
  const toggle = nav?.querySelector<HTMLButtonElement>('.jump-toggle');
  const current = nav?.querySelector<HTMLElement>('.jump-current');
  const links = [...(nav?.querySelectorAll<HTMLAnchorElement>('a[href^="#"]') ?? [])];

  const setOpen = (open: boolean) => {
    nav?.classList.toggle('open', open);
    toggle?.setAttribute('aria-expanded', String(open));
  };
  toggle?.addEventListener('click', () => setOpen(!nav?.classList.contains('open')));
  links.forEach((a) => a.addEventListener('click', () => setOpen(false)));

  // Markiert den Eintrag des Abschnitts, der gerade direkt unter der Leiste beginnt.
  const targets = links.map((a) => document.getElementById(a.hash.slice(1))).filter((el): el is HTMLElement => !!el);
  let ticking = false;
  const update = () => {
    ticking = false;
    const offset = (nav?.getBoundingClientRect().bottom ?? 0) + 40;
    const active = targets.filter((t) => t.getBoundingClientRect().top <= offset).pop();
    const hash = active ? `#${active.id}` : '';
    links.forEach((a) => (a.hash === hash ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
    if (current) current.textContent = links.find((a) => a.hash === hash)?.textContent ?? '';
  };
  addEventListener(
    'scroll',
    () => {
      if (!ticking) requestAnimationFrame(update);
      ticking = true;
    },
    { passive: true },
  );
  update();
</script>
