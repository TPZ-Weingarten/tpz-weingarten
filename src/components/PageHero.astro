---
import { Image } from 'astro:assets';
import { img } from '../lib/images';

interface Props {
  heading: string;
  subtitle?: string;
  image?: string;
}

const { heading, subtitle, image } = Astro.props;
---

<section class:list={['hero', { 'hero--plain': !image }]}>
  {image && <Image src={img(image)} alt="" widths={[640, 1024, 1600, 1920]} sizes="100vw" loading="eager" fetchpriority="high" class="bg" />}
  <div class="container content">
    <h1>{heading}</h1>
    {subtitle && <p>{subtitle}</p>}
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(15rem, 10rem + 14vw, 22rem);
    color: #fff;
    background: var(--grey);
    overflow: hidden;
    border-bottom: 4px solid var(--green);
  }

  .bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(0 0 0 / 0.05) 0%, rgb(0 0 0 / 0.55) 100%);
  }

  .content {
    position: relative;
    z-index: 1;
    padding-block: 2.5rem;
  }

  h1 {
    margin: 0;
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.35);
  }

  p {
    margin: 0.5rem 0 0;
    font-size: 1.2rem;
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.4);
  }

  .hero--plain {
    min-height: 0;
    color: var(--text);
    background: var(--green-tint);
    border-bottom-width: 1px;
    border-bottom-color: var(--green-line);
  }

  .hero--plain::after {
    display: none;
  }

  .hero--plain h1 {
    text-shadow: none;
  }

  .hero--plain .content {
    padding-block: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }
</style>
