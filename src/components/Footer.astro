---
import { getEntry } from 'astro:content';
import Icon from './Icon.astro';
import { url } from '../lib/url';

const site = (await getEntry('site', 'site'))!.data;
const icons = { Facebook: 'facebook', Instagram: 'instagram' } as const;
---

<footer class="site-footer">
  <div class="container inner">
    <div class="social">
      {
        site.social.map((s) => (
          <a href={s.url} target="_blank" rel="noopener noreferrer">
            <Icon name={icons[s.name]} size={22} label={s.name} />
          </a>
        ))
      }
    </div>
    <p class="copy">© {new Date().getFullYear()} {site.name}</p>
    <nav aria-label="Rechtliches">
      {site.footerNav.map((item) => <a href={url(item.href)}>{item.label}</a>)}
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--grey);
    color: #fff;
    font-size: 0.95rem;
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-block: 1.5rem;
  }

  .social {
    display: flex;
    gap: 0.5rem;
  }

  .social a {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    border: 1.5px solid rgb(255 255 255 / 0.5);
    color: #fff;
    transition:
      background-color 0.15s,
      border-color 0.15s;
  }

  .social a:hover {
    background: var(--green);
    border-color: var(--green);
    color: #16210a;
  }

  .copy {
    margin: 0;
    color: rgb(255 255 255 / 0.85);
  }

  nav {
    display: flex;
    gap: 1.5rem;
  }

  nav a {
    color: #fff;
    text-decoration: none;
  }

  nav a:hover {
    text-decoration: underline;
    text-decoration-color: var(--green);
  }

  @media (max-width: 720px) {
    .inner {
      flex-direction: column;
      text-align: center;
    }

    .copy {
      order: 3;
    }
  }
</style>
