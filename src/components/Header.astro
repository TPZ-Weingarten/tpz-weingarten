---
import { getEntry } from 'astro:content';
import Icon from './Icon.astro';
import { url, currentPath } from '../lib/url';

const site = (await getEntry('site', 'site'))!.data;
const path = currentPath(Astro.url.pathname);
---

<header class="site-header">
  <div class="container bar">
    <a href={url('/')} class="brand">
      <img src={url('/logo.svg')} width="899" height="289" alt={site.name} />
    </a>

    <button class="toggle" type="button" aria-expanded="false" aria-controls="main-nav">
      <Icon name="menu" class="icon-open" />
      <Icon name="close" class="icon-close" />
      <span class="sr-only">Menü</span>
    </button>

    <nav id="main-nav" class="nav" aria-label="Hauptnavigation">
      <ul>
        {
          site.nav.map((item) => (
            <li>
              <a href={url(item.href)} aria-current={path === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="nav-phone" href={`tel:${site.phone.href}`}>
        <Icon name="phone" size={18} />
        {site.phone.display}
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.site-header .toggle');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    document.documentElement.classList.toggle('nav-open', open);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--grey);
    border-bottom: 1px solid var(--grey-line);
    color: #fff;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: var(--header-h);
  }

  .brand img {
    width: auto;
    height: 3.5rem;
  }

  .nav ul {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav a {
    display: block;
    color: #fff;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
  }

  .nav ul a {
    padding: 0.5rem 0.7rem;
    border-radius: 999px;
    transition: background-color 0.15s;
  }

  .nav ul a:hover {
    background: rgb(255 255 255 / 0.12);
  }

  .nav ul a[aria-current='page'] {
    background: var(--green);
    color: #16210a;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .nav-phone {
    display: inline-flex !important;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.9rem;
    border: 1.5px solid rgb(255 255 255 / 0.6);
    border-radius: 999px;
    white-space: nowrap;
  }

  .nav-phone:hover {
    border-color: var(--green);
    color: var(--green) !important;
  }

  .toggle {
    display: none;
    padding: 0.5rem;
    margin-right: -0.5rem;
    background: none;
    border: 0;
    color: #fff;
    cursor: pointer;
  }

  .toggle :global(.icon-close),
  :global(.nav-open) .toggle :global(.icon-open) {
    display: none;
  }

  :global(.nav-open) .toggle :global(.icon-close) {
    display: block;
  }

  @media (max-width: 1100px) {
    .nav-phone {
      display: none !important;
    }
  }

  @media (max-width: 860px) {
    .brand img {
      height: 2.6rem;
    }

    .toggle {
      display: block;
    }

    .nav {
      display: none;
      position: absolute;
      inset: 100% 0 auto;
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
      padding: 1rem var(--gutter) 1.5rem;
      background: var(--grey);
      border-bottom: 1px solid var(--grey-line);
      box-shadow: 0 16px 24px -12px rgb(0 0 0 / 0.35);
    }

    :global(.nav-open) .nav {
      display: flex;
    }

    .nav ul {
      flex-direction: column;
    }

    .nav ul a {
      padding: 0.75rem 1rem;
      font-size: 1.05rem;
      border-radius: var(--radius-sm);
    }

    .nav-phone {
      display: inline-flex !important;
      justify-content: center;
      padding: 0.75rem 1rem;
    }
  }
</style>
